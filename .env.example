# QuietPay configuration. Copy to .env.local. All values are public (NEXT_PUBLIC_*);
# never put private keys here.

# --- Network selection ---------------------------------------------------------
# Testnet is the default. Mainnet stays disabled unless this is exactly "true".
NEXT_PUBLIC_ENABLE_MAINNET=false
# "testnet" or "mainnet" (mainnet is ignored unless enabled above).
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# --- Robinhood Chain Testnet (chain ID 46630) ---------------------------------
NEXT_PUBLIC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# ERC-5564 announcer you deployed with `npm run contracts:deploy`.
# Its runtime bytecode must match contracts/artifacts/ERC5564Announcer.json.
NEXT_PUBLIC_TESTNET_ANNOUNCER_ADDRESS=
# QuietPay Test USDG (MOCK, symbol tUSDG). No verified testnet USDG exists,
# so testnet uses this clearly labelled, worthless mock token.
NEXT_PUBLIC_TESTNET_TOKEN_ADDRESS=
NEXT_PUBLIC_TESTNET_CONFIRMATIONS=1
# QuietPay router (one-transaction payments with a gas stipend). Optional.
NEXT_PUBLIC_TESTNET_ROUTER_ADDRESS=
# Shielded pool (Privacy Pools by 0xbow), printed by `DEPLOY=pool npm run contracts:deploy`.
# Leave empty to hide the pool. Every contract is verified against the build at runtime.
NEXT_PUBLIC_TESTNET_POOL_ENTRYPOINT=
NEXT_PUBLIC_TESTNET_POOL_ADDRESS=
NEXT_PUBLIC_TESTNET_POOL_FROM_BLOCK=
# Relayer endpoint. Defaults to this site's /api/relay.
NEXT_PUBLIC_TESTNET_RELAYER_URL=

# --- Robinhood Chain mainnet (chain ID 4663) -----------------------------------
# USDG (0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168) is hard-coded and verified onchain.
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_MAINNET_ANNOUNCER_ADDRESS=
NEXT_PUBLIC_MAINNET_CONFIRMATIONS=3

# --- WalletConnect (optional) -------------------------------------------------
# Free project ID from https://dashboard.reown.com. Enables mobile wallets via QR code
# or deep link. Add your site's domain to the project's allowlist. Public value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Limits and scanning --------------------------------------------------------
# Human units; converted with the token's onchain decimals.
NEXT_PUBLIC_MIN_PAYMENT=0.01
NEXT_PUBLIC_MAX_PAYMENT=10000
# Max blocks per eth_getLogs request (halved automatically on RPC range errors).
NEXT_PUBLIC_LOG_CHUNK_SIZE=50000

# --- Pool relayer and approver (server only, set in the host's secret settings) ---
# A separate throwaway testnet account, funded with testnet ETH. Never the deployer,
# which owns the pool. It submits withdrawals and publishes approval roots.
# RELAYER_PRIVATE_KEY=0x...
# RELAYER_FEE_BPS=50                 # 0.5% of each withdrawal
# RELAYER_GAS_DROP_ETH=0.0002        # ETH left at an empty receiving address
# POOL_APPROVAL_DELAY_SECONDS=600    # deposits are approved once this old

# --- Deploy script only (never NEXT_PUBLIC) -------------------------------------
# DEPLOYER_PRIVATE_KEY=0x...   # throwaway testnet key, pass inline, do not commit
# RPC_URL=https://rpc.testnet.chain.robinhood.com
